{
  "name": "subscription-launchpad",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,ANGULAR \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:ui": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build && npm run build:worker && node scripts/finalize-build.mjs",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/server/index.js",
    "start": "npm run dev",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/subscription.test.ts",
    "lint": "eslint src lib worker scripts tests --ext .ts,.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "mongodb": "^7.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
